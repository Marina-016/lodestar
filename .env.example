# Lodestar 环境配置（复制为 .env 并按需修改）

# LLM：live = 真实 Anthropic API（或 ANTHROPIC_BASE_URL/ANTHROPIC_AUTH_TOKEN 指向的兼容网关）；
# mock = 离线夹具（不烧 token，用于冒烟/回归）
LODESTAR_LLM_MODE=live
# 对话默认走 Lodestar Research Loop；显式改为 codex 才启用 Codex Harness + MCP
# LODESTAR_CONVERSATION_HARNESS=codex
ANTHROPIC_API_KEY=
# 走内网模型路由网关时（Anthropic 兼容）：
# ANTHROPIC_BASE_URL=http://<gateway>
# ANTHROPIC_AUTH_TOKEN=<token>

# 显式请求思考（默认关闭）。模型/网关不支持时会报错，不静默关闭。
# LODESTAR_LLM_THINKING=false
# enabled = 固定预算；effort = 支持它的兼容服务；adaptive = 支持它的 Anthropic 模型。
# LODESTAR_LLM_THINKING_MODE=enabled
# LODESTAR_LLM_THINKING_BUDGET=4096
# LODESTAR_LLM_REASONING_EFFORT=high  # effort/adaptive: low / medium / high / max
# 总输出上限，默认8192；Anthropic固定思考预算必须小于它，并预留回答空间。
# LODESTAR_MAX_TOKENS=8192
# 可选模型档位映射。不配置时 /profile 只切预算/思考，沿用当前模型。
# LODESTAR_MODEL_FAST=<model-id>
# LODESTAR_MODEL_BALANCED=<model-id>
# LODESTAR_MODEL_DEEP=<model-id>
# 交互命令：/profile deep、/model 模型ID、/thinking on、/settings、/models remote
# Shared native dialogue budget (searches, reads and publication checks); 1-20.
# LODESTAR_DIALOGUE_MAX_OPERATIONS=8

# V1-R2：PDF 全文读取（默认关；开启后仅 Top N 论文来源读全文，token 预算守护）
# LODESTAR_FULL_TEXT=false
# LODESTAR_FULL_TEXT_MAX_SOURCES=2

# V3 Build executor（默认 codex，Apache-2.0 开源；可切 claude）
# LODESTAR_BUILD_EXECUTOR=codex
# LODESTAR_CODEX_MODEL=deepseek-v4-flash
# 空 = 用本机自带 codex 配置（ChatGPT 登录）；填内网网关 /v1 则走 OpenAI Responses API
# LODESTAR_CODEX_BASE_URL=
# LODESTAR_CODEX_API_KEY=
# 保险开关：true 时未配 BASE_URL 会拒绝用 codex 默认模式（防误烧 ChatGPT Plus 额度）；确认要用再设 false
# LODESTAR_CODEX_REQUIRE_GATEWAY=true
# Optional Windows npm shim / local proxy settings. They are injected into Codex only.
# LODESTAR_CODEX_NODE_BIN=C:/path/to/node/bin
# LODESTAR_CODEX_PROXY=http://127.0.0.1:7897
# LODESTAR_DEMO_REPLAY=false  # curated replay for a reliable demo; visibly labelled in UI

# 模型（可选覆盖默认值）
LODESTAR_MODEL=claude-sonnet-5
LODESTAR_JUDGE_MODEL=claude-haiku-4-5-20251001

# 检索后端（web 目前支持 duckduckgo；arxiv 无需 Key）
LODESTAR_WEB_SEARCH_BACKEND=duckduckgo

# V1-R1：venue 元数据回填（免费无 Key；false 可关闭）
LODESTAR_ENRICH_VENUES=true
# LODESTAR_VENUE_PROVIDERS=semanticscholar,openalex,dblp,crossref   # provider 顺序回退链
# LODESTAR_VENUE_ENRICH_LIMIT=10        # 单任务最多回填篇数（防限流）
# LODESTAR_VENUE_REQUEST_INTERVAL_S=1.2 # provider 节流间隔（无 Key 约 1 QPS）

# Brief 语言：zh / en
LODESTAR_BRIEF_LANGUAGE=zh

# 数据/产物路径（默认在项目内）
# LODESTAR_DB_PATH=
# LODESTAR_WORKSPACE_DIR=

# Alibaba low-cost backend (set these to override Anthropic)
# LODESTAR_LLM_PROVIDER=dashscope
# LODESTAR_LLM_BASE_URL=https://YOUR_WORKSPACE.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_API_KEY=
# LODESTAR_MODEL=qwen-flash
# LODESTAR_JUDGE_MODEL=qwen-flash

# Stop live model calls while billing/free-quota status is unverified; mock still works.
LODESTAR_MODEL_CALLS_DISABLED=true

# Explicit project model-export scope; empty blocks live project proposals.
LODESTAR_PROJECT_MODEL_ALLOWED_REPOSITORY=
LODESTAR_PROJECT_MODEL_ALLOWED_PATHS=
